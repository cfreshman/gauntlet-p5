{
  "name": "music-aipi",
  "version": "1.0.0",
  "description": "An intelligent music discovery assistant powered by AI, Spotify, and Last.fm",
  "main": "src/index.js",
  "scripts": {
    "start": "node --no-deprecation src/index.js",
    "dev": "nodemon --no-deprecation src/index.js",
    "test": "jest --no-deprecation",
    "test:unit": "jest --no-deprecation src/tests/unit",
    "test:integration": "jest --no-deprecation src/tests/integration",
    "lint": "eslint src/**/*.js",
    "generate-docs": "swagger-jsdoc -d src/layer0/swagger.js -o src/layer0/openapi.json",
    "mcp:layer1": "node --no-deprecation src/mcp/demo.js 1",
    "mcp:layer2": "node --no-deprecation src/mcp/demo.js 2",
    "mcp:layer3": "node --no-deprecation src/mcp/demo.js 3",
    "mcp:test": "node --no-deprecation src/mcp/test-client.js",
    "mcp:all": "node --no-deprecation src/mcp/run-all.js",
    "mcp:test-all": "node --no-deprecation src/mcp/test-all.js",
    "music-discovery": "node --no-deprecation src/cli/music-discovery-cli.js",
    "music-chat": "node --no-deprecation src/chat/music-discovery-chat.js",
    "test:message-processor": "node --no-deprecation src/chat/test-message-processor.js",
    "web:dev": "cd web-client && npm run dev",
    "web:build": "cd web-client && npm run build",
    "web:serve": "cd web-client && npm run serve",
    "web:install": "cd web-client && npm install",
    "web:server": "node --no-deprecation src/web-server.js",
    "web:with-mcp": "node --no-deprecation -e \"require('child_process').spawn('node', ['--no-deprecation', 'src/mcp/run-all.js'], {stdio: 'inherit'}); setTimeout(() => require('child_process').spawn('node', ['--no-deprecation', 'src/web-server.js'], {stdio: 'inherit'}), 5000);\""
  },
  "keywords": [
    "AI",
    "API",
    "LLM",
    "MCP",
    "OpenAPI",
    "Music",
    "Spotify",
    "Last.fm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-openapi-validator": "^5.0.6",
    "express-session": "^1.18.1",
    "express-winston": "^4.2.0",
    "joi": "^17.11.0",
    "openai": "^4.20.1",
    "punycode-esm": "^1.0.15",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "eslint": "^8.54.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  }
}
